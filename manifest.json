{
  "manifest_version": 3,
  "name": "Meet Attendance Tracker",
  "version": "3.0",
  "description": "Зберігає списки, відстежує відвідуваність та дозволяє редагувати ПІБ та примітки.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"]
    }
  ],
  "minimum_chrome_version": "90"
}

